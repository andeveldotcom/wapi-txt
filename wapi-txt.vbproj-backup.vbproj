<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <RootNamespace>wapi_txt</RootNamespace>
    <StartupObject>wapi_txt.Module1</StartupObject>
    <LangVersion>default</LangVersion>
    <ImportedNamespaces>System.Net.Http=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Data=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,wapi-txt=True</ImportedNamespaces>
    <AssemblyVersion></AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net462|AnyCPU'">
    <DefineConstants>COMMON,NET462</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net462|AnyCPU'">
    <DefineConstants>COMMON,NET462</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
    <DefineConstants>COMMON,NET8_0</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0|AnyCPU'">
    <DefineConstants>COMMON,NET8_0</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Settings -->
    <None Include="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>

    <!-- Manifest a konfigurace -->
    <None Include="My Project\app.manifest" />
    <None Include="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Include="App.config" />

    <!-- Doplňkové soubory (původně None; resources budou embedded níže) -->
    <None Include="Resources\config.dtd" />
    <None Include="Resources\parameters.xsd">
      <SubType>Designer</SubType>
    </None>
    <None Include="Resources\eula.txt" />
    <None Include="Resources\idna-chars.txt" />
    <None Include="Resources\parameters.xslt" />
  </ItemGroup>

  <!-- Embed all files under Resources as EmbeddedResource for multi-target builds -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.*" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
  <Reference Include="System.Net.Http" />
</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
   <Reference Include="System.Security" />
 </ItemGroup>


  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Include="My Project\AssemblyInfo.net8.vb" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Compile Include="My Project\AssemblyInfo.net462.vb" />
  </ItemGroup>

  <!-- Add per‑TFM AssemblyInfo files explicitly (do not remove them) -->

  <ItemGroup>
    <Compile Remove="My Project\AssemblyInfo.net8.vb" Condition="false" />
    <Compile Remove="My Project\AssemblyInfo.net462.vb" Condition="false" />
  </ItemGroup>

</Project>